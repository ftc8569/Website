{
  "name": "roboknights",
  "version": "1.0.10",
  "private": true,
  "dockerImage": "docker.bedson.tech/tbedson/roboknights",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "docker:build": "node build.mjs",
    "docker:push": "node build.mjs --push",
    "format": "npx prettier . --write",
    "createAdminUser": "node scripts/createAdminUser.js",
    "prisma:deploy": "npx prisma db push",
    "typecheck": "tsc --noEmit",
    "check:format": "prettier --check app components scripts DESIGN.md README.md eslint.config.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "audit:react": "react-doctor . --no-supply-chain --no-telemetry",
    "test:cad": "node scripts/cad-check.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/three": "^0.186.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.2",
    "katex": "^0.19.0",
    "markdown-it": "^14.1.0",
    "next": "^16.3.8",
    "next-recaptcha-v3": "^1.5.3",
    "nodemailer": "^10.0.14",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^14.3.8",
    "react-easy-crop": "^5.4.1",
    "react-icons": "^5.5.0",
    "react-responsive-masonry": "^2.6.0",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "24.5.2",
    "@types/nodemailer": "^6",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "@types/react-responsive-masonry": "^2.1.3",
    "@types/showdown": "^2.0.6",
    "eslint": "~9.39.1",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "playwright-lighthouse": "^4.0.0",
    "postcss": "~8.5.6",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "react-doctor": "^0.9.14",
    "react-grab": "^0.2.0",
    "react-scan": "^0.5.7",
    "tailwindcss": "^4.0.0",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3"
  }
}
